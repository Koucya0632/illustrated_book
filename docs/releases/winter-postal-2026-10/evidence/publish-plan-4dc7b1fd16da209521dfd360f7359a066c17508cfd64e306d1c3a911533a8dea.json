      "word": {
        "id": "new-years-postcard",
        "word": "New Year's postcard",
        "chinese": "賀年明信片",
        "chineseDefinition": "日本郵便發行、供新年問候使用的郵資已付明信片，帶有「年賀」標示及抽獎號碼。年賀状指新年問候信，不限使用這種明信片。",
        "category": "postal-services",
        "partOfSpeech": "noun",
        "pronunciation": "/ˌnuː jɪrz ˈpoʊst.kɑːrd/",
        "cefrLevel": "B1",
        "definitions": [
          {
            "language": "zh",
            "definition": "賀年明信片",
            "sortOrder": 0
          },
          {
            "language": "en",
            "definition": "A postage-paid postcard issued by Japan Post for New Year greetings, marked for New Year delivery and carrying a lottery number. A New Year's greeting can also be sent on other stationery.",
            "sortOrder": 0
          },
          {
            "language": "ja",
            "definition": "日本郵便が年始のあいさつ用に発行する、年賀の表示とお年玉くじの番号がある料金込みのはがき。年賀状は新年のあいさつを記した書状で、通常はがきなどでも送れる。",
            "sortOrder": 0
          }
        ],
        "examples": [
          {
            "en": "I'd like ten New Year's postcards.",
            "ja": "年賀はがきを十枚ください。",
            "zh": "我想買十張賀年明信片。",
            "cefrLevel": "A2"
          },
          {
            "en": "I bought extra New Year's postcards because I might make a mistake writing the addresses.",
            "ja": "宛名を書き間違えるかもしれないので、年賀はがきを多めに買いました。",
            "zh": "因為可能寫錯收件地址，我多買了幾張賀年明信片。",
            "cefrLevel": "B1"
          }
        ],
        "relatedWords": [
          "postcard"
        ],
        "ja": "年賀はがき",
        "jaReading": "ねんがはがき",
