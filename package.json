{
  "name": "everyday-english-picture-dictionary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "eval": "node evals/run-eval.mjs",
    "eval:db": "node evals/run-eval.mjs --source database",
    "eval:spans": "node evals/run-generation-eval.mjs",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "migrate": "tsx scripts/migrate.ts",
    "sync-image-urls": "tsx scripts/sync-image-urls.ts",
    "enrich": "tsx scripts/enrich.ts",
    "translate": "tsx scripts/translate.ts",
    "translate:audit": "tsx scripts/translate.ts --audit-only",
    "translate:google": "tsx scripts/backfill-ja-google.ts",
    "translate:readings": "tsx scripts/backfill-ja-readings.ts",
    "apply:texts": "tsx scripts/apply-localized-texts.ts",
    "apply:atlas-glosses": "tsx scripts/apply-atlas-glosses.ts",
    "fix:main-words": "tsx --env-file=.env.local scripts/apply-main-word-corrections.ts",
    "fix:main-word-examples": "tsx --env-file=.env.local scripts/apply-main-word-corrections.ts",
    "fix:main-word-merges": "tsx --env-file=.env.local scripts/apply-main-word-merges.ts",
    "audit:main-words": "tsx --env-file=.env.local scripts/audit-main-words.ts",
    "audio:generate": "tsx --env-file=.env.local scripts/generate-audio.ts",
    "examples:spans": "tsx --env-file=.env.local scripts/generate-example-spans.ts",
    "fix:seasonings-example-spans": "tsx scripts/correct-seasonings-example-spans.ts",
    "verify:atlas": "node scripts/verify-atlas-privacy.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.109",
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "ai": "^6.0.193",
    "next": "^16.3.4",
    "opencc-js": "^1.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.22.3",
    "typescript": "^5.5.3"
  }
}
